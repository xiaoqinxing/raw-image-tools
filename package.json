{
  "name": "rawlab",
  "private": true,
  "version": "0.1.0",
  "description": "Browser-based RAW image editing and ISP analysis workbench",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xiaoqinxing/raw-image-tools.git"
  },
  "homepage": "https://raw-image.li.qinxing.xyz",
  "bugs": {
    "url": "https://github.com/xiaoqinxing/raw-image-tools/issues"
  },
  "engines": {
    "node": ">=18.19"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "bench": "node scripts/bench-browser.mjs"
  },
  "dependencies": {
    "@colorhythm/libraw-wasm": "1.1.1",
    "@radix-ui/react-dialog": "1.1.4",
    "@radix-ui/react-dropdown-menu": "2.1.4",
    "@radix-ui/react-slider": "1.2.2",
    "@radix-ui/react-switch": "1.1.2",
    "@radix-ui/react-tabs": "1.1.2",
    "@radix-ui/react-tooltip": "1.1.6",
    "fast-png": "6.4.0",
    "fft.js": "4.0.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "3.25.76",
    "zustand": "5.0.2"
  },
  "devDependencies": {
    "@playwright/test": "1.49.1",
    "@types/node": "22.10.5",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@vitejs/plugin-react": "4.3.4",
    "autoprefixer": "10.4.20",
    "pixelmatch": "6.0.0",
    "pngjs": "7.0.0",
    "postcss": "8.4.49",
    "tailwindcss": "3.4.17",
    "typescript": "5.7.3",
    "vite": "5.4.21",
    "vitest": "2.1.9"
  }
}
